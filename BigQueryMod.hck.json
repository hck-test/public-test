      "glossaryId": "baaeda07-2f07-4c8d-a2ad-7ce8b8d1ec0b",
      "name": "Land Parcel Party Role",
      "properties": {
        "cd79ddf1-bdaf-4390-90cc-2428da5a1ef3": "0c631183-3e59-47f8-b15a-37c17b0619c0",
        "c881bee1-4371-4f15-a92b-20258bde0555": "Land Parcel Party Role",
        "bb9e3dbb-0193-4f1a-bf6b-910efbf79f5d": "A role that a party plays with respect to a land parcel (e.g., prospector, partner, worker, stakeholder), used to manage permissions, responsibilities, and business relationships tied to the property.",
